{
  "expo": {
    "name": "Mostaza Cocina KDS",
    "slug": "mostaza-cocina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mostazacocina",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.anonymous.mostazacocina",
      "adaptiveIcon": {
        "backgroundColor": "#A30002",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A30002",
          "image": "./assets/images/icon.png",
          "imageWidth": 80
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
